{
  "prog": "05-validation.py",
  "help": "Type coercion and ValidationRule checks",
  "cli_args": {
    "count": {
      "type": "int",
      "validation": {
        "min": 1,
        "max": 100
      },
      "help": "Record limit"
    },
    "status": {
      "type": "str",
      "validation": {
        "choices": ["active", "inactive", "pending"]
      },
      "help": "Status"
    },
    "name": {
      "type": "str",
      "validation": {
        "min_length": 2,
        "max_length": 20
      },
      "help": "Dataset name"
    },
    "symbol": {
      "type": {
        "pattern": "^\\d{6}\\.(SH|SZ)$"
      },
      "help": "A-share code, e.g. 600000.SH"
    },
    "overwrite": {
      "type": "bool",
      "help": "Overwrite existing output"
    }
  }
}
