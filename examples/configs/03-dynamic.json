{
  "prog": "03-dynamic.py",
  "help": "Parameter set grows at runtime depending on --source",
  "cli_args": {
    "type": {
      "type": "str",
      "required": true,
      "action": "load_dynamic_params",
      "depends_on": ["source"],
      "help": "Data type"
    },
    "source": {
      "type": "str",
      "action": "guess_source",
      "help": "Data source"
    }
  }
}
